# Copy this file to .env and fill in the real values.
# .env is already in .gitignore - NEVER commit real credentials.
# These belong to a real account on a live third-party production site.
# Treat them the same way you'd treat a client's production credentials:
# don't paste them into commit messages, PR descriptions, Slack, or CI logs.

# Credentials for the one account used to validate the authenticated
# journeys (QAB-E2E-013, QAB-E2E-031). Login runs ONCE via tests/auth.setup.ts
# and the session is reused via storageState - specs never re-submit the
# login form individually, to keep this low-volume against production.
AUTH_EMAIL=
AUTH_PASSWORD=

# Optional override, defaults to https://qabiile.com in playwright.config.ts
BASE_URL=
